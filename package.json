{
  "name": "kandala",
  "version": "0.16.2",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint 'src/**/*.{js,ts,jsx,tsx}' --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint --fix 'src/**/*.{js,ts,jsx,tsx}'",
    "format": "prettier --write 'src/**/*.{js,ts,jsx,tsx}' --config ./.prettierrc",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "src/**/*.{js,ts,jsx,tsx}": [
      "npm run lint",
      "npm run format"
    ]
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "clsx": "^2.1.1",
    "next": "15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/css": "^0.6.0",
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.24.0",
    "@eslint/json": "^0.11.0",
    "@next/eslint-plugin-next": "^15.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.25.1",
    "eslint-config-next": "15.3.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unicorn": "^58.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "3.5.3",
    "sass": "^1.86.3",
    "typescript": "^5",
    "typescript-eslint": "^8.30.1"
  }
}
